<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DocumentChecker.Engine.MainWindow"
        Title="Document Checker"
        Width="1500"
        Height="900"
        MinWidth="1100"
        MinHeight="680"
        FontFamily="Segoe UI, Helvetica Neue, Arial"
        Background="#F3F5F9">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Background" Value="#F1F5F9" />
      <Setter Property="Foreground" Value="#172B4D" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#2457C5" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="22,10" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="Button.review">
      <Setter Property="Background" Value="#F59E0B" />
      <Setter Property="Foreground" Value="#1F2937" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.square">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#E2E8F0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BoxShadow" Value="0 1 3 0 #14000000" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#64748B" />
    </Style>
    <Style Selector="TextBlock.legend">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="#475569" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="5,0,14,0" />
    </Style>
    <Style Selector="ToggleButton.segment">
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Background" Value="#F1F5F9" />
      <Setter Property="Foreground" Value="#334155" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ToggleButton.segment:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2457C5" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#2457C5" />
    </Style>
    <Style Selector="ToggleButton.left">
      <Setter Property="CornerRadius" Value="6,0,0,6" />
    </Style>
    <Style Selector="ToggleButton.right">
      <Setter Property="CornerRadius" Value="0,6,6,0" />
    </Style>
    <Style Selector="Button.small">
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="White" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="2" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="14" RowSpacing="10">

    <!-- 1. Choose the two documents -->
    <Border Classes="card" Padding="14,10">
      <Grid ColumnDefinitions="Auto,*,*,Auto,Auto" ColumnSpacing="12">
        <StackPanel VerticalAlignment="Center" Spacing="1" Margin="0,0,6,0">
          <TextBlock FontSize="19" FontWeight="SemiBold" Foreground="#172B4D" Text="Document Checker" />
          <TextBlock FontSize="12" Foreground="#64748B" Text="Runs on this computer · never changes your files" />
        </StackPanel>

        <Border Grid.Column="1" Background="#FFF5F6" BorderBrush="#FECDD3" BorderThickness="1" CornerRadius="8" Padding="12,7">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <StackPanel Spacing="1" VerticalAlignment="Center">
              <TextBlock Classes="caption" Foreground="#9F1239" TextTrimming="CharacterEllipsis" Text="① APPROVED (REFERENCE)" />
              <TextBlock x:Name="ReferencePathText" FontSize="14" FontWeight="SemiBold" Foreground="#172B4D" TextTrimming="CharacterEllipsis" Text="Not chosen yet" />
            </StackPanel>
            <Button Grid.Column="1" Click="SelectReference_Click" Background="White">Choose…</Button>
          </Grid>
        </Border>

        <Border Grid.Column="2" Background="#F3FCF6" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="12,7">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <StackPanel Spacing="1" VerticalAlignment="Center">
              <TextBlock Classes="caption" Foreground="#166534" TextTrimming="CharacterEllipsis" Text="② TO CHECK (CURRENT)" />
              <TextBlock x:Name="CurrentPathText" FontSize="14" FontWeight="SemiBold" Foreground="#172B4D" TextTrimming="CharacterEllipsis" Text="Not chosen yet" />
            </StackPanel>
            <Button Grid.Column="1" Click="SelectCurrent_Click" Background="White">Choose…</Button>
          </Grid>
        </Border>

        <Button x:Name="HistoryButton" Grid.Column="3" Click="History_Click" Padding="14,10"
                ToolTip.Tip="Every comparison made on this computer: when, by whom, which files and what was found. Compare again or export to CSV.">History</Button>
        <StackPanel Grid.Column="4" Spacing="4" VerticalAlignment="Center">
          <Button x:Name="CompareButton" Classes="primary" Click="Compare_Click" IsEnabled="False"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">Compare</Button>
          <CheckBox x:Name="HeadersFootersCheckBox" IsChecked="True" FontSize="12" MinHeight="0" Padding="4,0,0,0"
                    IsCheckedChanged="HeadersFooters_Changed"
                    ToolTip.Tip="Compare the headers and footers too. Switch off to leave them out: they are then not compared and not shown. Changing this compares again at once, and the choice is remembered.">Include headers &amp; footers</CheckBox>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 2. Result and actions -->
    <Border Grid.Row="1" Classes="card" Padding="14,8">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="6">
          <TextBlock x:Name="StatusText" FontSize="15" FontWeight="SemiBold" Foreground="#172B4D" TextWrapping="Wrap" VerticalAlignment="Center"
                     Text="Choose the approved document and the document to check, then click Compare." />
          <Grid Grid.Row="1" Grid.ColumnSpan="5" ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <WrapPanel x:Name="LegendPanel" IsVisible="False" Orientation="Horizontal" VerticalAlignment="Center"
                     ToolTip.Tip="What the colours mean in the two documents. Click any highlight to see it explained.">
            <Border Width="16" Height="11" BorderBrush="#F87171" BorderThickness="0,0,0,2" VerticalAlignment="Center" />
            <TextBlock Classes="legend" Text="Approved value" />
            <Border Width="16" Height="11" BorderBrush="#4ADE80" BorderThickness="0,0,0,2" VerticalAlignment="Center" />
            <TextBlock Classes="legend" Text="Current value" />
            <Border Width="16" Height="11" Background="#FDF2F8" BorderBrush="#F472B6" BorderThickness="1" VerticalAlignment="Center" />
            <TextBlock Classes="legend" Text="Missing, added or formatting" />
            <Border Width="16" Height="11" Background="#FFFBEB" BorderBrush="#F59E0B" BorderThickness="3,0,0,0" VerticalAlignment="Center" />
            <TextBlock Classes="legend" Text="Check yourself" />
            <Border Width="16" Height="11" Background="#F1F5F9" BorderBrush="#64748B" BorderThickness="1" VerticalAlignment="Center" />
            <TextBlock Classes="legend" Text="Image ↔ table" />
            <TextBlock Classes="legend" Foreground="#94A3B8" Text="·  Click any highlight to see it explained" />
          </WrapPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <ToggleButton x:Name="ReadingViewButton" Classes="segment left" IsChecked="True" Click="ReadingView_Click"
                          ToolTip.Tip="Reading view: the text of both documents side by side, kept level line by line. Fast; the layout is simplified.">Reading view</ToggleButton>
            <ToggleButton x:Name="ExactViewButton" Classes="segment right" Click="ExactView_Click"
                          ToolTip.Tip="Exact pages: the real pages, laid out by Microsoft Word or LibreOffice, with the differences marked on them.">Exact pages</ToggleButton>
          </StackPanel>
          </Grid>

        <Button x:Name="NextReviewButton" Grid.Column="1" Classes="review" Click="NextReview_Click" IsVisible="False"
                ToolTip.Tip="Go through each item you need to check yourself. They are amber in the documents and beside the scroll bars.">Next to review</Button>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Click="PreviousDifference_Click" ToolTip.Tip="Previous difference">‹ Previous</Button>
          <TextBlock x:Name="PositionText" MinWidth="58" TextAlignment="Center" VerticalAlignment="Center" Foreground="#475569" Text="" />
          <Button Click="NextDifference_Click" ToolTip.Tip="Next difference">Next ›</Button>
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button Classes="square" Click="ZoomOut_Click" ToolTip.Tip="Smaller text">−</Button>
          <TextBlock x:Name="ZoomText" MinWidth="44" TextAlignment="Center" VerticalAlignment="Center" Foreground="#475569" Text="100%" />
          <Button Classes="square" Click="ZoomIn_Click" ToolTip.Tip="Larger text">+</Button>
          <Button x:Name="HighlightToggleButton" Click="HighlightToggle_Click" Margin="6,0,0,0"
                  ToolTip.Tip="Hide the highlights to read the documents as they are. Changes stay clickable.">Hide highlights</Button>
        </StackPanel>

        <Button x:Name="GeneratePdfButton" Grid.Column="4" Click="GeneratePdf_Click" IsEnabled="False">Save PDF report</Button>
      </Grid>
    </Border>

    <!-- 3. The two documents side by side, and the list of differences -->
    <Grid Grid.Row="2" ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <!-- The list narrows on small screens so the documents keep most of the width. -->
        <ColumnDefinition Width="0.75*" MinWidth="300" MaxWidth="380" />
      </Grid.ColumnDefinitions>
      <Border Classes="card" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
          <Border Background="#FFF5F6" BorderBrush="#FECDD3" BorderThickness="0,0,0,1" Padding="14,8">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
              <Border Width="10" Height="10" CornerRadius="5" Background="#E11D48" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="1">
                <TextBlock FontWeight="Bold" Foreground="#9F1239" Text="Approved · Reference" />
                <TextBlock x:Name="ReferenceDocumentName" FontSize="12" Foreground="#64748B" Text="No document selected" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ReferenceExactNote" FontSize="11.5" Foreground="#92400E" TextWrapping="Wrap" IsVisible="False" />
              </StackPanel>
              <Button x:Name="OpenReferenceButton" Grid.Column="2" Classes="small" Click="OpenReference_Click"
                      ToolTip.Tip="Opens a read-only copy of this document in Microsoft Word (or your default app for .docx), so the original cannot be changed.">Open in Word</Button>
            </Grid>
          </Border>
          <Grid Grid.Row="1" ColumnDefinitions="*,12">
            <ScrollViewer x:Name="ReferenceScrollViewer"
                          Background="#EEF1F5"
                          VerticalScrollBarVisibility="Visible"
                          HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="ReferenceScrollViewer_ScrollChanged">
              <Panel>
                <Border x:Name="ReferencePageSurface" MaxWidth="900" HorizontalAlignment="Stretch" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Margin="12" Padding="26,22" BoxShadow="0 1 4 0 #18000000">
                  <StackPanel x:Name="ReferenceDocumentPanel" Spacing="12" />
                </Border>
                <StackPanel x:Name="ReferenceExactPanel" IsVisible="False" Spacing="10" Margin="12" />
              </Panel>
            </ScrollViewer>
            <Canvas x:Name="ReferenceOverview" Grid.Column="1" Background="#E2E8F0" ClipToBounds="True"
                    ToolTip.Tip="Where the differences are in this document. Amber = check yourself. Click a mark to jump to it." />
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="card" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
          <Border Background="#F3FCF6" BorderBrush="#BBF7D0" BorderThickness="0,0,0,1" Padding="14,8">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
              <Border Width="10" Height="10" CornerRadius="5" Background="#16A34A" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Spacing="1">
                <TextBlock FontWeight="Bold" Foreground="#166534" Text="Being checked · Current" />
                <TextBlock x:Name="CurrentDocumentName" FontSize="12" Foreground="#64748B" Text="No document selected" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="CurrentExactNote" FontSize="11.5" Foreground="#92400E" TextWrapping="Wrap" IsVisible="False" />
              </StackPanel>
              <Button x:Name="OpenCurrentButton" Grid.Column="2" Classes="small" Click="OpenCurrent_Click"
                      ToolTip.Tip="Opens a read-only copy of this document in Microsoft Word (or your default app for .docx), so the original cannot be changed.">Open in Word</Button>
            </Grid>
          </Border>
          <Grid Grid.Row="1" ColumnDefinitions="*,12">
            <ScrollViewer x:Name="CurrentScrollViewer"
                          Background="#EEF1F5"
                          VerticalScrollBarVisibility="Visible"
                          HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="CurrentScrollViewer_ScrollChanged">
              <Panel>
                <Border x:Name="CurrentPageSurface" MaxWidth="900" HorizontalAlignment="Stretch" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Margin="12" Padding="26,22" BoxShadow="0 1 4 0 #18000000">
                  <StackPanel x:Name="CurrentDocumentPanel" Spacing="12" />
                </Border>
                <StackPanel x:Name="CurrentExactPanel" IsVisible="False" Spacing="10" Margin="12" />
              </Panel>
            </ScrollViewer>
            <Canvas x:Name="CurrentOverview" Grid.Column="1" Background="#E2E8F0" ClipToBounds="True"
                    ToolTip.Tip="Where the differences are in this document. Amber = check yourself. Click a mark to jump to it." />
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="2" Classes="card" Padding="12">
        <Grid RowDefinitions="Auto,*,*" RowSpacing="10">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#172B4D" Text="Differences" />
              <TextBlock x:Name="DifferenceCountText" Grid.Column="1" Foreground="#64748B" VerticalAlignment="Center" Text="" />
            </Grid>
            <ComboBox x:Name="FindingFilter" HorizontalAlignment="Stretch" SelectionChanged="FindingFilter_SelectionChanged" SelectedIndex="0">
              <ComboBoxItem>All differences</ComboBoxItem>
              <ComboBoxItem>Missing or added content</ComboBoxItem>
              <ComboBoxItem>Table values and structure</ComboBoxItem>
              <ComboBoxItem>Images and recognized text</ComboBoxItem>
              <ComboBoxItem>Check yourself</ComboBoxItem>
            </ComboBox>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBlock x:Name="SelectionScopeText" Text="All changes · click a highlighted value to focus" TextWrapping="Wrap" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" />
              <Button x:Name="ShowAllChangesButton" Grid.Column="1" Click="ShowAllChanges_Click" IsVisible="False" Padding="8,3" FontSize="12">Show all</Button>
            </Grid>
          </StackPanel>

          <ListBox x:Name="DifferenceList"
                   Grid.Row="1"
                   SelectionChanged="DifferenceList_SelectionChanged"
                   Background="Transparent"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                  <Grid ColumnDefinitions="4,*">
                    <Border Background="{Binding Accent}" />
                    <StackPanel Grid.Column="1" Spacing="2" Margin="10,7">
                      <TextBlock FontWeight="SemiBold" Foreground="#172B4D" TextWrapping="Wrap" Text="{Binding Operation}" />
                      <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#2457C5" TextWrapping="Wrap" Text="{Binding TransitionAndCount}" IsVisible="{Binding HasTransition}" />
                      <TextBlock FontSize="13" Foreground="#9F1239" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Text="{Binding Before}" />
                      <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#166534" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Text="{Binding After}" />
                      <TextBlock FontSize="11" Foreground="#64748B" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Text="{Binding LineDescription}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
            <Panel>
              <TextBlock x:Name="DetailEmptyText" Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12"
                         Text="Select a difference in the list, or click a highlight in either document, to see it explained here." />
              <ScrollViewer x:Name="DetailScrollViewer" IsVisible="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="9">
                  <TextBlock x:Name="DetailOperationText" FontSize="16" FontWeight="SemiBold" Foreground="#172B4D" TextWrapping="Wrap" />
                  <TextBlock x:Name="DetailConfidenceText" FontWeight="SemiBold" TextWrapping="Wrap" Padding="8,5" Background="#FFFBEB" />
                  <TextBlock x:Name="DetailReviewText" Foreground="#92400E" TextWrapping="Wrap" IsVisible="False" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Border Background="#FFF1F2" BorderBrush="#FECDD3" BorderThickness="1" CornerRadius="6" Padding="9,7">
                      <StackPanel Spacing="3">
                        <TextBlock Classes="caption" Foreground="#9F1239" Text="APPROVED · REFERENCE" />
                        <SelectableTextBlock x:Name="DetailReferenceText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <Border x:Name="DetailReferenceImageFrame" IsVisible="False" BorderBrush="#E11D48" BorderThickness="2" CornerRadius="3" Padding="2" HorizontalAlignment="Left">
                          <Image x:Name="DetailReferenceImage" IsVisible="False" MaxHeight="90" Stretch="Uniform" HorizontalAlignment="Left" />
                        </Border>
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="9,7">
                      <StackPanel Spacing="3">
                        <TextBlock Classes="caption" Foreground="#166534" Text="CURRENT" />
                        <SelectableTextBlock x:Name="DetailCurrentText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <Border x:Name="DetailCurrentImageFrame" IsVisible="False" BorderBrush="#16A34A" BorderThickness="2" CornerRadius="3" Padding="2" HorizontalAlignment="Left">
                          <Image x:Name="DetailCurrentImage" IsVisible="False" MaxHeight="90" Stretch="Uniform" HorizontalAlignment="Left" />
                        </Border>
                      </StackPanel>
                    </Border>
                  </Grid>
                  <TextBlock x:Name="DetailSourceTruthText" Foreground="#334155" TextWrapping="Wrap" />
                  <StackPanel Spacing="2">
                    <TextBlock Classes="caption" Text="WHERE" />
                    <TextBlock x:Name="DetailLocationText" Foreground="#334155" TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Spacing="2">
                    <TextBlock Classes="caption" Text="WHAT TO DO" />
                    <TextBlock x:Name="DetailActionText" Foreground="#334155" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button x:Name="ShowOnPagesButton" Classes="primary" Click="ShowOnPages_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          FontSize="13.5" Padding="12,8"
                          ToolTip.Tip="Open the approved page and the current page side by side, as Word or LibreOffice lays them out, with this difference marked on both.">Show on the real pages</Button>
                  <Expander x:Name="DetailMoreExpander" Header="More details" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="6">
                      <TextBlock x:Name="DetailCategoryText" TextWrapping="Wrap" />
                      <Grid x:Name="DetailContentKindGrid" ColumnDefinitions="*,*" ColumnSpacing="6" IsVisible="False">
                        <TextBlock x:Name="DetailReferenceContentKindText" Foreground="#9F1239" TextWrapping="Wrap" />
                        <TextBlock x:Name="DetailCurrentContentKindText" Grid.Column="1" Foreground="#166534" TextWrapping="Wrap" />
                      </Grid>
                      <TextBlock x:Name="DetailRepresentationText" TextWrapping="Wrap" IsVisible="False" />
                      <TextBlock x:Name="DetailPageNoteText" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" IsVisible="False" />
                      <SelectableTextBlock x:Name="DetailContextText" TextWrapping="Wrap" FontSize="12" Foreground="#475569" />
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </ScrollViewer>
            </Panel>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- 4. What is and is not checked -->
    <Expander Grid.Row="3" Header="What this tool checks, and what to check yourself" HorizontalAlignment="Stretch">
      <TextBlock x:Name="CoverageText" Foreground="#475569" FontSize="12" TextWrapping="Wrap"
                 Text="Checked: body text, headers, footers, footnotes, endnotes, direct formatting (including hidden text), symbols, tables and embedded images. Page-number and date fields in headers and footers are compared as fields, not as their printed values. Check yourself: values read from images (OCR), equations, list numbering, styles inherited from templates, page layout, and anything marked amber. Only an identical file (same bytes) is reported as an exact match." />
    </Expander>
  </Grid>
</Window>
