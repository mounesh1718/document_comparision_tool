# Build output
bin/
obj/
artifacts/

# Scratch and test-run output (builds, screenshots, probes)
tmp/
TestResults/
*.log

# IDE / user files
.vs/
.vscode/
.idea/
*.user
*.suo

# Documents under review must never be committed (they may be confidential)
*.docx
*.doc
!tests/**/*.docx.keep
# Synthetic sample documents for manual testing (no real or confidential content)
!samples/*.docx
